    ],
    "note": null,
    "order": 2
  },
  {
    "id": "kana-hi-row-s",
    "title": "Hiragana: the さ row",
    "script": "hiragana",
    "introduces": [
      "kana:hi:sa",
      "kana:hi:shi",
      "kana:hi:su",
      "kana:hi:se",
      "kana:hi:so"
    ],
    "prerequisites": [
      "kana-hi-row-k"
    ],
    "note": "Watch the i-column: し is shi, not \"si\".",
    "order": 3
  },
  {
    "id": "kana-hi-row-t",
    "title": "Hiragana: the た row",
    "script": "hiragana",
    "introduces": [
