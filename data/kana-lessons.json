[
  {
    "id": "kana-hi-row-vowel",
    "title": "Hiragana: the five vowels",
    "script": "hiragana",
    "introduces": [
      "kana:hi:a",
      "kana:hi:i",
      "kana:hi:u",
      "kana:hi:e",
      "kana:hi:o"
    ],
    "prerequisites": [],
    "note": "The five vowels. Every other kana is one of these with a consonant in front, so the five sounds a-i-u-e-o are the whole phonetic system in miniature. Japanese u is said with flat, unrounded lips.",
    "order": 1
  },
  {
    "id": "kana-hi-row-k",
