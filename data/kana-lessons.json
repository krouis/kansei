      "kana-hi-row-s"
    ],
    "note": "Two irregular cells here: ち is chi and つ is tsu, not \"ti\" and \"tu\".",
    "order": 4
  },
  {
    "id": "kana-hi-row-n",
    "title": "Hiragana: the な row",
    "script": "hiragana",
