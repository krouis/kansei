      "kana:hi:small-i",
      "kana:hi:small-u",
      "kana:hi:small-e",
      "kana:hi:small-o"
    ],
    "prerequisites": [
      "kana-hi-small"
    ],
    "note": "Half-size vowels. Hiragana barely uses them; they are here so you recognise them, and because the katakana versions build every loanword sound Japanese lacks a kana for.",
    "order": 12
  },
  {
    "id": "kana-hi-row-g",
    "title": "Hiragana: the が row",
