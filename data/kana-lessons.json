    "prerequisites": [
      "kana-hi-row-y"
    ],
    "note": "One tapped consonant for the whole row, between an English r and l.",
    "order": 9
  },
  {
    "id": "kana-hi-row-w",
    "title": "Hiragana: the わ row",
    "script": "hiragana",
