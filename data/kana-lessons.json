  {
    "id": "kana-hi-row-h",
    "title": "Hiragana: the は row",
    "script": "hiragana",
    "introduces": [
      "kana:hi:ha",
      "kana:hi:hi",
      "kana:hi:fu",
      "kana:hi:he",
      "kana:hi:ho"
    ],
    "prerequisites": [
      "kana-hi-row-n"
    ],
    "note": "ふ is fu, not \"hu\" — the consonant is lighter than an English f, made with the lips alone. は has a second life as the topic particle, where it is pronounced \"wa\".",
    "order": 6
  },
  {
    "id": "kana-hi-row-m",
    "title": "Hiragana: the ま row",
    "script": "hiragana",
