{
  "name": "kansei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kansei — an offline-first PWA for learning Japanese writing and beginner vocabulary.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:fetch": "node scripts/assets/fetch-sources.mjs",
    "content:build": "node scripts/content/build-content.mjs",
    "content:validate": "node scripts/content/validate-content.mjs",
    "content:verify-references": "node scripts/content/verify-references.mjs",
    "content:strokes": "node scripts/content/build-strokes.mjs",
    "content:components": "node scripts/content/build-components.mjs",
    "fonts:build": "node scripts/assets/build-fonts.mjs",
    "icons:build": "node scripts/assets/build-icons.mjs",
    "audio:fetch": "node scripts/assets/fetch-audio.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:viz": "node scripts/check-viz-palette.mjs",
    "check:kana": "node scripts/checks/verify-kana.mjs && node scripts/checks/verify-kana-schema.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
